# Copy to .env for local runs. Never commit real keys.
# LLM (primary -> fallback chain configured in app/agent/llm.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=300

# STT/TTS (Sarvam). Empty key = deterministic mock + browser WebSpeech fallback.
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_LANGUAGE=hi-IN

# Feature flags
VOICE_ENABLED=false
LLM_MOCK_DEFAULT=true
VOICE_LATENCY_BUDGET_MS=2000

# Paths
LOG_DIR=logs
DB_PATH=data/app.db

# Planner / grocery reproducibility. Set to -1 for random seed each run.
PLANNER_SEED=42
GROCERY_SEED=42
